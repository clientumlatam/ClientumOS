# ==============================================================================
# CONFIGURACIÓN COMPLETA DE ENTORNOS DE DESARROLLO / PRODUCCIÓN Y ALTERNATIVAS FREE
# CLIENTUM LATAM SUITE — Guía de Variables de Entorno y Capas Gratuitas (Free Tier)
# ==============================================================================
# Todas las integraciones cuentan con alternativas y capas gratuitas permanentes
# sin costo oculto ni necesidad obligatoria de ingresar tarjeta de crédito.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
ALLOWED_DOMAINS=localhost,127.0.0.1,clientum.app
ALLOWED_EMAIL_DOMAINS=gmail.com,company.com,outlook.com

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon)
# Gratis: Neon (0.5 GB almacenamiento gratis perpetuo), Supabase, Render PostgreSQL o ElephantSQL
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_123456@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:npg_123456@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://oauth2.neon.tech
VITE_NEON_AUTH_URL=https://oauth2.neon.tech

# ------------------------------------------------------------------------------
# 3. Firebase Client Configuration for Social Auth & Password Reset
# Gratis: Plan Spark de Firebase (autenticación ilimitada para Email/Password y OAuth Google)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyA1234567890ExampleKey
VITE_FIREBASE_AUTH_DOMAIN=clientum-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=clientum-app
VITE_FIREBASE_STORAGE_BUCKET=clientum-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:a1b2c3d4e5f6g7h8

# ------------------------------------------------------------------------------
# 4. AI & Gemini API
# Gratis: Google AI Studio / Gemini API (Nivel gratuito con límites de RP/minuto)
# Alternativas Free: Ollama (Local), Groq Cloud API (14,400 req/día), OpenRouter (modelos free)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyA1234567890GeminiKey
GEMINI_API_KEY_V2=AIzaSyA1234567890GeminiKeyV2

# ------------------------------------------------------------------------------
# 5. Authentication & Security
# Generar claves secretas localmente con: openssl rand -hex 32
# ------------------------------------------------------------------------------
BETTER_AUTH_SEC=8f4a2e5d9c1b3f7e6a0d2c4b8f1a3e5d7c9b1a3f5e7d9c1b3f5e7d9c1b3f5e7d
SESSION_SECRET=e3f5d7c9b1a3f5e7d9c1b3f5e7d9c1b3f8f4a2e5d9c1b3f7e6a0d2c4b8f1a3e5
ALLOWED_SIGN_IN=google,email

# ------------------------------------------------------------------------------
# 6. Google OAuth & Workspace SSO
# Gratis: Google Cloud Console (crear credenciales de cliente OAuth sin costo)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=123456789012-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example_client_secret_123
GOOGLE_ACCESS_TOKEN=ya29.a0AfH6SM...

# ------------------------------------------------------------------------------
# 7. Email SMTP (Transactional Emails: Welcome, Login, Password Reset)
# Gratis: Gmail SMTP (usando Contraseñas de aplicación de Google)
# Alternativas Free: Resend (3,000 mails/mes gratis), Brevo (300 mails/día gratis)
# ------------------------------------------------------------------------------
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# ------------------------------------------------------------------------------
# 8. Location, Prospecting & Map Services
# Gratis: Google Maps Platform (incluye $200 USD de crédito gratuito mensual)
# Alternativas Free: OpenStreetMap / Nominatim, Leaflet, LocationIQ (5,000 req/día), Mapbox (50k cargas/mes)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=AIzaSyA1234567890GoogleMapsKey
GOOGLE_MAPS_API_KEY=AIzaSyA1234567890GoogleMapsKey
GOOGLE_MAPS_KEY=AIzaSyA1234567890GoogleMapsKey
GOOGLE_MAPS_PLATFORM_KEY=AIzaSyA1234567890GoogleMapsKey

# ------------------------------------------------------------------------------
# 9. Scraping & Automation
# Gratis: Apify (Plan gratis con $5 USD/mes en créditos de cómputo)
# Gratis: Hunter.io (Plan gratis con 25 búsquedas/mes). Alternativas: Snov.io (50 créditos), Skrapp.io (50 créditos)
# Gratis: Santi API / Custom Scraper Keys
# ------------------------------------------------------------------------------
APIFY_API_TOKEN=apify_api_1234567890abcdef
HUNTER_API_KEY=hunter_key_1234567890abcdef
SANTI_API_KEY=santi_key_1234567890abcdef

# ------------------------------------------------------------------------------
# 10. WhatsApp Meta API
# Gratis: Cuenta de Desarrollador Meta (número de pruebas Sandbox 100% gratuito + 1,000 conv/mes)
# ------------------------------------------------------------------------------
META_WA_ACCESS_TOKEN=EAAG...
META_WA_APP_SECRET=meta_app_secret_32_hex
META_WA_BUSINESS_ACCOUNT_ID=100012345678901
META_WA_PHONE_NUMBER_ID=100098765432109
META_WA_VERIFY_TOKEN=mi_token_de_verificacion_webhook_custom

# ------------------------------------------------------------------------------
# 11. Push Notifications / Service Workers
# Gratis: Generar con la librería web-push ejecutando localmente: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
VAPID_PRIVATE_KEY=your_vapid_private_key_base64
VAPID_PUBLIC_KEY=your_vapid_public_key_base64

# ------------------------------------------------------------------------------
# 12. System & Cron Jobs
# Generar claves secretas localmente con: openssl rand -hex 32
# ------------------------------------------------------------------------------
CRON_SECRET=super_secret_cron_job_token
CRM_INTERNAL_TOKEN=internal_crm_service_token_123

# ------------------------------------------------------------------------------
# 13. Cloudflare Workers & D1 Webmail Suite
# Token de autenticación del Worker (webmail.clientum.com.ar)
# ------------------------------------------------------------------------------
WEBMAIL_PASSWORD=clientum_d1_webmail_secret_2026
WEBMAIL_WORKER_URL=https://webmail.clientum.com.ar
VITE_WEBMAIL_PASSWORD=clientum_d1_webmail_secret_2026
VITE_WEBMAIL_WORKER_URL=https://webmail.clientum.com.ar
