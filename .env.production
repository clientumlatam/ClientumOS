# ========================================================================
# CLIENTUMOS - PRODUCCIÓN
# Dominio: clientum.com.ar | Vercel Deployment | Google AI + OAuth
# ========================================================================
# 🔒 NO COMMITEAR CON VALORES REALES
# Guardar todas las claves sensibles en: Vercel > Project > Settings > Environment Variables
# ========================================================================

# ─────────────────────────────────────────────────────────────────────
# 1) URLs Y ENTORNO
# ─────────────────────────────────────────────────────────────────────
APP_URL=https://clientum.com.ar
FRONTEND_URL=https://clientum.com.ar
API_URL=https://clientum.com.ar/api
NODE_ENV=production
VERCEL_ENV=production
PORT=3000

# ─────────────────────────────────────────────────────────────────────
# 2) SEGURIDAD Y DOMINIOS PERMITIDOS
# ─────────────────────────────────────────────────────────────────────
ALLOWED_DOMAINS=clientum.com.ar,www.clientum.com.ar
ALLOWED_EMAIL_DOMAINS=clientum.com.ar,gmail.com
ALLOWED_SIGN_IN=google,github,email

# ─────────────────────────────────────────────────────────────────────
# 3) BASE DE DATOS (POSTGRES / NEON)
# ─────────────────────────────────────────────────────────────────────
# Reemplaza con tu string de conexión real (SSL obligatorio en producción)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://neon_user:neon_pass@ep-abc123.us-east-1.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://oauth2.neon.tech
VITE_NEON_AUTH_URL=https://oauth2.neon.tech

# ─────────────────────────────────────────────────────────────────────
# 4) GOOGLE AI / GEMINI (Google AI Studio)
# ─────────────────────────────────────────────────────────────────────
# OPCIÓN A: API Key simple (para desarrollo)
GEMINI_API_KEY=AIzaSyD_placeholder_your_gemini_api_key_here

# OPCIÓN B: Service Account JSON (recomendado para producción)
# Guardar el JSON completo en Vercel como Secret y luego referenciar aquí
# Ej: GEMINI_SA_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
# GEMINI_SA_JSON=@vercel/secret_gemini_sa_json

# Model names (ajusta según tu proyecto Google AI)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_VISION=gemini-1.5-pro-vision

# ─────────────────────────────────────────────────────────────────────
# 5) OAUTH: GOOGLE (Google Identity / NextAuth)
# ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://clientum.com.ar/api/auth/callback/google
GOOGLE_API_KEY=AIzaSyD_your_general_google_api_key

# ─────────────────────────────────────────────────────────────────────
# 6) OAUTH: GITHUB
# ─────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_REDIRECT_URI=https://clientum.com.ar/api/auth/callback/github

# ─────────────────────────────────────────────────────────────────────
# 7) FIREBASE (opcional, si usas en cliente: prefijo VITE_)
# ─────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ─────────────────────────────────────────────────────────────────────
# 8) EMAIL / TRANSACCIONAL (Resend recomendado)
# ─────────────────────────────────────────────────────────────────────
# Usar Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Alternativa: SMTP genérico
SMTP_USER=sender@clientum.com.ar
SMTP_PASS=your_smtp_app_password_here
SMTP_HOST=smtp.sendprovider.com
SMTP_PORT=465
SMTP_SECURE=true

# ─────────────────────────────────────────────────────────────────────
# 9) WEB PUSH NOTIFICATIONS (VAPID)
# ─────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key_base64_here
VAPID_PRIVATE_KEY=your_vapid_private_key_base64_here

# ─────────────────────────────────────────────────────────────────────
# 10) AUTENTICACIÓN / SEGURIDAD
# ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32 (para SESSION_SECRET)
# Generar con: openssl rand -hex 64 (para BETTER_AUTH_SEC)
SESSION_SECRET=your_session_secret_64_hex_chars_here
BETTER_AUTH_SEC=your_better_auth_secret_128_hex_chars_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# ─────────────────────────────────────────────────────────────────────
# 11) JOBS / CRON / INTEGRACIONES INTERNAS
# ─────────────────────────────────────────────────────────────────────
CRON_SECRET=your_cron_secret_64_hex_chars_here
CRM_INTERNAL_TOKEN=your_crm_internal_token_here

# ─────────────────────────────────────────────────────────────────────
# 12) WHATSAPP / META (opcional)
# ─────────────────────────────────────────────────────────────────────
META_WA_ACCESS_TOKEN=your_meta_whatsapp_access_token
META_WA_APP_SECRET=your_meta_app_secret_here
META_WA_BUSINESS_ACCOUNT_ID=123456789012345
META_WA_PHONE_NUMBER_ID=123456789012345
META_WA_VERIFY_TOKEN=your_webhook_verify_token_here

# ─────────────────────────────────────────────────────────────────────
# 13) OBSERVABILITY / LOGGING
# ─────────────────────────────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────
# 14) DEVELOPMENT / PREVIEW (comentar en producción si no necesario)
# ─────────────────────────────────────────────────────────────────────
# DEBUG=clientum:*
# DEVELOPMENT_MODE=false

# ========================================================================
# NOTAS FINALES
# ========================================================================
# ✅ Generar secrets con:
#    openssl rand -hex 32  -> SESSION_SECRET (64 chars)
#    openssl rand -hex 64  -> BETTER_AUTH_SEC (128 chars)
#
# ✅ Generar VAPID keys con:
#    npx web-push generate-vapid-keys --json
#
# ✅ Guardar TODOS los valores en Vercel > Settings > Environment Variables
#    Marcar como "Protected" si soporta Vercel.
#
# ✅ Redirect URIs OAuth:
#    - https://clientum.com.ar/api/auth/callback/google
#    - https://clientum.com.ar/api/auth/callback/github
#    - Añadir URLs de preview si necesitas: https://*.vercel.app/api/auth/callback/*
#
# ✅ NO exponer claves privadas en bundle frontend (sin prefijo VITE_)
# ========================================================================
