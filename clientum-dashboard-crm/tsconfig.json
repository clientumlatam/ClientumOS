{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@clientum/ui": ["./packages/ui/src/index.ts"],
      "@clientum/types": ["./packages/types/src/index.ts"],
      "@clientum/agents": ["./packages/agents/src/index.ts"],
      "@aime/wp-components": ["./packages/ui/src/wp-mocks.tsx"]
    }
  },
  "include": ["src", "packages"]
}
