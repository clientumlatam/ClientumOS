{
  "name": "webmail-clientum",
  "version": "1.0.0",
  "description": "Cloudflare Worker Serverless Webmail for Clientum Latam with D1 SQLite & Email Routing",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create webmail-db",
    "d1:init": "wrangler d1 execute webmail-db --remote --file=schema.sql",
    "d1:local": "wrangler d1 execute webmail-db --local --file=schema.sql"
  },
  "dependencies": {
    "postal-mime": "^2.1.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.6"
  }
}
