{
  "entities": {
    "GeolocatedProspect": {
      "title": "GeolocatedProspect",
      "description": "Scraped and enriched business prospect from Google Maps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "integer" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "enriched": { "type": "boolean" },
        "contactName": { "type": "string" },
        "contactRole": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "fitScore": { "type": "integer" },
        "painPoint": { "type": "string" },
        "outreachStrategy": { "type": "string" },
        "outreachSent": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "city"]
    },
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Contact": {
      "title": "Contact",
      "description": "CRM contact information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "jobTitle": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "CRM sales opportunity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "stage": { "type": "string" },
        "probability": { "type": "number" }
      },
      "required": ["id", "userId", "name", "amount", "stage"]
    },
    "Company": {
      "title": "Company",
      "description": "CRM company information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "domain": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "CRM task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/geolocated_prospects/{prospectId}": {
      "schema": { "$ref": "#/entities/GeolocatedProspect" },
      "description": "Geolocated business prospects collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles collection"
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "CRM contacts collection"
    },
    "/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/Opportunity" },
      "description": "CRM opportunities collection"
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "CRM companies collection"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "CRM tasks collection"
    }
  }
}
