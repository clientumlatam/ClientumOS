rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny-all por defecto. Nada en el código de la plataforma (Clientum
    // dashboard) usa el SDK de Firestore actualmente — toda la data real
    // vive en Postgres/Neon via server.ts. Estas reglas solo protegen el
    // proyecto Firebase mientras no esté en uso.
    //
    // Si en el futuro se implementa "Firestore Cloud Sync" (mencionado en
    // AiHubTab.tsx pero sin código detrás todavía), reemplazar este bloque
    // por reglas por colección atadas a auth real, por ejemplo:
    //
    // match /companies/{companyId} {
    //   allow read, write: if request.auth != null
    //     && request.auth.uid == resource.data.ownerId;
    // }
    //
    // El backend (server.ts) usando el Admin SDK de Firebase (si se llega
    // a usar) ignora estas reglas por completo, así que escribir desde el
    // server nunca se ve afectado por este cambio.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /contacts/{contactId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /geolocated_prospects/{prospectId} {
      allow read, write: if request.auth != null;
    }
  }
}
