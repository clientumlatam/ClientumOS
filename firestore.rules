rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isResourceOwner() { return isSignedIn() && resource.data.userId == request.auth.uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // CRM Contacts
    match /contacts/{contactId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isResourceOwner();
    }
    
    // CRM Opportunities
    match /opportunities/{opportunityId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isResourceOwner();
    }
    
    // CRM Companies
    match /companies/{companyId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isResourceOwner();
    }
    
    // CRM Tasks
    match /tasks/{taskId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isResourceOwner();
    }
    
    // Geolocated Prospects
    match /geolocated_prospects/{prospectId} {
      allow read, write: if isSignedIn();
    }
  }
}
